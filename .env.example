# Copy to .env and fill in (local development only).
# Real deployments read the same variables from the platform secret manager.

SANVI_ENV=local

# Optional local overrides. Unset reserves API=1, worker=2, CLI=3.
# Non-local deployments must set a unique SANVI__IDS__NODE_ID per replica.
# SANVI__IDS__NODE_ID=1

# Local docker-compose credentials (dev only — these are the compose defaults)
SANVI__DATABASE__PASSWORD=app-local-dev
SANVI__DATABASE__MIGRATOR_PASSWORD=migrator-local-dev
SANVI__REDIS__URL=redis://localhost:6379

# Internal tenant header signing key (service-to-service/worker). Dev only;
# production uses the secret manager. Without a secret the internal-header
# channel is disabled (subdomain resolution still works).
# SANVI__TENANCY__SIGNING_KEYS__K1=change-me-local-dev-secret
# SANVI__TENANCY__ACTIVE_KEY_ID=k1

# Kratos webhook secret: must match SANVI_WEBHOOK_SECRET in docker-compose
# (default `webhook-local-dev-secret`). Without it the /internal/kratos/*
# receivers refuse everything (and Kratos login/registration fail).
SANVI__IDENTITY__WEBHOOK_SECRET=webhook-local-dev-secret

# OIDC provider secrets (optional in local dev): the compose stack forwards
# these into Kratos. See docs/runbooks/add-oidc-provider.md.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...

# Optional OTLP export to OpenObserve (default: off; needs `dev.sh up --full`).
# The token is base64 of the compose root credentials
# (root@sanvi.local:OpenObserve-local-dev1) — dev only; real environments read
# their own token from the platform secret manager.
# SANVI__TELEMETRY__OTLP__ENABLED=true
# SANVI__TELEMETRY__OTLP__ENDPOINT=http://localhost:5081
# SANVI__TELEMETRY__OTLP__AUTH_TOKEN=cm9vdEBzYW52aS5sb2NhbDpPcGVuT2JzZXJ2ZS1sb2NhbC1kZXYx

# Stripe (phase 04). Restricted key with least-privilege scopes — never a
# live secret key. Real environments read these from the secret manager;
# local dev uses stripe-mock + stripe-cli (see docs/runbooks/billing.md).
# SANVI__BILLING__STRIPE_API_BASE=https://api.stripe.com
# SANVI__BILLING__STRIPE_API_KEY=<restricted key, rk_ prefix>
# SANVI__BILLING__STRIPE_WEBHOOK_SECRET=<webhook signing secret, whsec_ prefix>

# Stripe Connect (phase 09). A DIFFERENT restricted key from billing's,
# carrying only Connect permissions; the webhook secret signs
# /internal/webhooks/stripe/connect and MUST differ from billing's
# (validated at boot). Without a key the catalog answers and no provider
# calls are made; without a secret the Connect endpoint rejects everything.
# SANVI__PAYMENTS__CONNECT_API_KEY=<restricted key, rk_ prefix>
# SANVI__PAYMENTS__CONNECT_WEBHOOK_SECRET=<webhook signing secret, whsec_ prefix>

# Privacy (phase 05). The KEK is the key-encryption key for per-subject
# envelope encryption: 32 random bytes, base64-encoded. Without it envelope
# encryption fails closed (exports and crypto-shred refuse to run). Generate:
#   openssl rand -base64 32
# SANVI__PRIVACY__KEK=

# Localization (phase 06). English and Japanese ship in the binary; tenant
# settings live in localization.tenant_locales and copy overrides in
# localization.translations. Optional overrides (defaults shown):
# SANVI__LOCALIZATION__DEFAULT_LOCALE=en
# SANVI__LOCALIZATION__EXPLICIT_LOCALE_ALLOWLIST__0=en
# SANVI__LOCALIZATION__EXPLICIT_LOCALE_ALLOWLIST__1=ja

# Theming (phase 07). The base theme ships in the migration; install more
# with `cargo run -p sanvi-cli -- theme publish crates/contexts/theming/themes/aurora`
# Preview tokens need a secret (base64, >= 32 bytes); without one the draft
# preview endpoint fails closed. Dev only:
# SANVI__THEMING__PREVIEW_TOKEN_SECRET=Y2hhbmdlLW1lLWxvY2FsLWRldi1zZWNyZXQtdmFsdWUtaGVyZQ==

# Domains (phase 08). The edge proxy presents this secret on
# /internal/tls/authorize before it issues certificates on demand. Without
# it the gate fails closed (no certificate is ever authorized). Generate:
#   openssl rand -hex 32
# SANVI__DOMAINS__INTERNAL_SECRET=
# Optional caller CIDR allow-list (one env var per entry):
# SANVI__DOMAINS__INTERNAL_ALLOWED_IPS__0=10.0.0.0/8

# Notification service (Lane A / Lane B). Empty base_url means fail closed
# (notifications disabled). Values empty; dev secrets via local env only.
# SANVI__NOTIFICATION__BASE_URL=
# SANVI__NOTIFICATION__SEND_API_KEY=
# SANVI__NOTIFICATION__READ_API_KEY=
