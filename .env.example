# Copy to .env and fill in (local development only).
# Real deployments read the same variables from the platform secret manager.

SANVI_ENV=local

# Local docker-compose credentials (dev only — these are the compose defaults)
SANVI__DATABASE__PASSWORD=app-local-dev
SANVI__DATABASE__MIGRATOR_PASSWORD=migrator-local-dev
SANVI__REDIS__URL=redis://localhost:6379

# Internal tenant header signing key (service-to-service/worker). Dev only;
# production uses the secret manager. Without a secret the internal-header
# channel is disabled (subdomain resolution still works).
# SANVI__TENANCY__SIGNING_KEYS__K1=change-me-local-dev-secret
# SANVI__TENANCY__ACTIVE_KEY_ID=k1

# Kratos webhook secret: must match SANVI_WEBHOOK_SECRET in docker-compose
# (default `webhook-local-dev-secret`). Without it the /internal/kratos/*
# receivers refuse everything (and Kratos login/registration fail).
SANVI__IDENTITY__WEBHOOK_SECRET=webhook-local-dev-secret

# OIDC provider secrets (optional in local dev): the compose stack forwards
# these into Kratos. See docs/runbooks/add-oidc-provider.md.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...

# Optional OTLP export to OpenObserve (default: off; needs `dev.sh up --full`).
# The token is base64 of the compose root credentials
# (root@sanvi.local:OpenObserve-local-dev1) — dev only; real environments read
# their own token from the platform secret manager.
# SANVI__TELEMETRY__OTLP__ENABLED=true
# SANVI__TELEMETRY__OTLP__ENDPOINT=http://localhost:5081
# SANVI__TELEMETRY__OTLP__AUTH_TOKEN=cm9vdEBzYW52aS5sb2NhbDpPcGVuT2JzZXJ2ZS1sb2NhbC1kZXYx

# Stripe (phase 04). Restricted key with least-privilege scopes — never a
# live secret key. Real environments read these from the secret manager;
# local dev uses stripe-mock + stripe-cli (see docs/runbooks/billing.md).
# SANVI__BILLING__STRIPE_API_BASE=https://api.stripe.com
# SANVI__BILLING__STRIPE_API_KEY=<restricted key, rk_ prefix>
# SANVI__BILLING__STRIPE_WEBHOOK_SECRET=<webhook signing secret, whsec_ prefix>
