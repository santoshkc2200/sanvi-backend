  "query": "SELECT id, aggregate, aggregate_id, event_type, payload, metadata,\n                      occurred_at, published_at, attempts\n               FROM platform.outbox\n               WHERE published_at IS NULL\n                 AND attempts < $1\n               ORDER BY occurred_at\n               LIMIT $2\n               FOR UPDATE SKIP LOCKED",
